# ─── JobNimbus ────────────────────────────────────────────────────────────────
JOBNIMBUS_API_KEY=mmijwpdfmpdirf41

# ─── PropertyRadar ────────────────────────────────────────────────────────────
# Sign up at https://www.propertyradar.com — activate the 30-day API trial in
# Account Settings to get your key: https://help.propertyradar.com/en/articles/8309200
PROPERTYRADAR_API_KEY=YOUR_PROPERTYRADAR_API_KEY

# ─── Webhook Security ─────────────────────────────────────────────────────────
# Set a random secret string and configure it in JobNimbus webhook settings
WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET

# ─── App ──────────────────────────────────────────────────────────────────────
# Set to "true" to use mocked PropertyRadar responses instead of live API calls
PROPERTYRADAR_MOCK=true

# ─── Claude / Anthropic (material order parsing + warranty matching) ──────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ─── Stalled Jobs Report — Email Recipients ───────────────────────────────────
RESEND_API_KEY=YOUR_RESEND_API_KEY          # https://resend.com (free: 100/day)
CRON_SECRET=YOUR_RANDOM_CRON_SECRET        # any random string
OPS_MANAGER_EMAIL=ops@rhinoroofs.com       # receives 2-day production alerts
SALES_MANAGER_EMAIL=sales@rhinoroofs.com   # receives 2-day sales alerts
COO_EMAIL=coo@rhinoroofs.com               # receives 5-day escalation alerts
